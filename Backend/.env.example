# AURA AI Backend Configuration
PROJECT_NAME="AURA AI Backend"
VERSION="4.5.0"
ENVIRONMENT="development"
DEBUG=True

# API Keys
GEMINI_API_KEY=""
OPENWEATHER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
INWORLD_TTS_KEY=""
DEEPGRAM_API_KEY=""



# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""

# Security
SECRET_KEY="aura-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Cache
DATABASE_URL="sqlite+aiosqlite:///./aura_ai.db"
REDIS_URL="redis://localhost:6379/0"

# Storage
STORAGE_DIR="./storage"
